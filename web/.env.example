# PayPal sandbox REST app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Webhook ID from the PayPal dashboard (used to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# Public base URL of this app (used for PayPal return/cancel URLs)
APP_BASE_URL=http://localhost:3000

# AI verifier. Any provider works; the default adapter calls the Anthropic Messages API.
# Leave blank to use the deterministic offline fallback verifier (good for demos/tests).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Largest amount the buyer agent may release without a human (default 500)
BUYER_AGENT_MAX_AMOUNT=500

# Set to 1 to enable demo-only endpoints (time shift, seed/reset)
DEMO_MODE=1

# SQLite file location (default ./data/tan.db). On Render, point this at a persistent disk.
# DATABASE_PATH=./data/tan.db

# Optional: grants the reviewer role on every deal (for an ops team). Leave blank to
# use only the per-deal reviewer links.
REVIEWER_KEY=

# Hard daily ceiling on AI model calls; beyond it the offline rules take over.
LLM_DAILY_CAP=300

# Optional: lets an external scheduler call /api/cron/sweep (Authorization: Bearer <secret>).
# The app also sweeps for expired holds itself every 10 minutes.
CRON_SECRET=
