      ]
    },
    {
      "name": "PayPal sandbox direct",
      "item": [
        {
          "name": "OAuth token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/v1/oauth2/token",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "oauth2",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{paypalClientId}}"
                },
                {
                  "key": "password",
                  "value": "{{paypalClientSecret}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('paypalToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order (intent AUTHORIZE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v2/checkout/orders",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"AUTHORIZE\",\n  \"purchase_units\": [\n    {\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"25.00\"\n      }\n    }\n  ],\n  \"payment_source\": {\n    \"paypal\": {\n      \"experience_context\": {\n        \"return_url\": \"{{baseUrl}}\",\n        \"cancel_url\": \"{{baseUrl}}\",\n        \"user_action\": \"PAY_NOW\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('orderId', r.id);",
                  "console.log((r.links.find(l => l.rel === 'payer-action') || {}).href);"
                ]
              }
            }
          ]
        },
        {
          "name": "Authorize order (after buyer approval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v2/checkout/orders/{{orderId}}/authorize",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders",
                "{{orderId}}",
                "authorize"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('authorizationId', pm.response.json().purchase_units[0].payments.authorizations[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Show authorization details (status, expiration_time)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/v2/payments/authorizations/{{authorizationId}}",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v2",
                "payments",
                "authorizations",
                "{{authorizationId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "Reauthorize (only after the 3-day honor period)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v2/payments/authorizations/{{authorizationId}}/reauthorize",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v2",
                "payments",
                "authorizations",
                "{{authorizationId}}",
                "reauthorize"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {\n    \"currency_code\": \"USD\",\n    \"value\": \"25.00\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('authorizationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Capture authorization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v2/payments/authorizations/{{authorizationId}}/capture",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v2",
                "payments",
                "authorizations",
                "{{authorizationId}}",
                "capture"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"final_capture\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "Void authorization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v2/payments/authorizations/{{authorizationId}}/void",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v2",
                "payments",
                "authorizations",
                "{{authorizationId}}",
                "void"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "Create payout (seller)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v1/payments/payouts",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "payments",
                "payouts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender_batch_header\": {\n    \"sender_batch_id\": \"postman-{{$guid}}\",\n    \"email_subject\": \"Sandbox payout\"\n  },\n  \"items\": [\n    {\n      \"recipient_type\": \"EMAIL\",\n      \"receiver\": \"{{sellerEmail}}\",\n      \"amount\": {\n        \"value\": \"25.00\",\n        \"currency\": \"USD\"\n      },\n      \"note\": \"Sandbox payout\",\n      \"sender_item_id\": \"item-{{$guid}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('payoutBatchId', pm.response.json().batch_header.payout_batch_id);"
                ]
              }
